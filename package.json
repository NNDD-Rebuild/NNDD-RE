{
  "name": "nndd-re",
  "version": "1.0.4",
  "description": "NNDD-RE - NicoNico Douga Downloader/Player",
  "main": "out/main/main.js",
  "author": "NNDD-RE Project",
  "license": "MPL-2.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "electron-vite build && npm run build:library-comment-bundle",
    "build:library-comment-bundle": "node scripts/buildLibraryCommentBundle.js",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-vite build && npm run build:library-comment-bundle && electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "dist:linux:docker": "node scripts/dist-linux-docker.js",
    "tc": "tsc --noEmit -p tsconfig.node.json",
    "tc:web": "tsc --noEmit -p tsconfig.web.json",
    "tc:all": "npm run tc && npm run tc:web",
    "check:ipc": "node scripts/check-ipc-coverage.mjs",
    "gen:proto": "buf generate"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.15.0",
    "@tanstack/react-virtual": "^3.14.9",
    "@xhayper/discord-rpc": "^1.3.4",
    "@xpadev-net/niconicomments": "^0.3.0",
    "better-sqlite3": "12.11.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "express": "^4.21.0",
    "fast-xml-parser": "^4.5.0",
    "hls.js": "^1.7.3",
    "mediabunny": "^1.50.8",
    "mpegts.js": "^1.8.0",
    "qrcode.react": "^4.2.0",
    "tough-cookie": "^5.0.0",
    "uuid": "^10.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.73.0",
    "@bufbuild/protoc-gen-es": "^2.15.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "electron": "^43.7.7",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.1",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true
  }
}
